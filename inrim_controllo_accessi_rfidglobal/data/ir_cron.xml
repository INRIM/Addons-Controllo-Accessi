<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="access_data_from_readers" model="ir.cron">
            <field name="name">INRiM: Read Data from Reades</field>
            <field name="model_id" ref="model_ca_punto_accesso"/>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.eval_readers_data()</field>
        </record>

        <record id="acess_decode_data_access" model="ir.cron">
            <field name="name">INRiM: Decode Readers Access Data</field>
            <field name="model_id" ref="model_ca_punto_accesso"/>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.load_readers_data()</field>
        </record>

        <record id="acces_update_readers_tags" model="ir.cron">
            <field name="name">INRiM:Update Readers Tags</field>
            <field name="model_id" ref="model_ca_punto_accesso"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.update_readers_data()</field>
        </record>

        <record id="acces_update_readers_tags" model="ir.cron">
            <field name="name">INRiM:Update Readers Clock</field>
            <field name="model_id" ref="model_ca_punto_accesso"/>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=4, minute=0, second=0, microsecond=0))"/>

            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.update_clock()</field>
        </record>
    </data>
</odoo>