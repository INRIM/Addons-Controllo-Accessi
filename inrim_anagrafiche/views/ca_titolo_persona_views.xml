<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_titolo_persona_view_form" model="ir.ui.view">
        <field name="name">ca.titolo.persona.view.form</field>
        <field name="model">ca.titolo_persona</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date_start"/>
                            <field name="structured"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="date_end"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ca_titolo_persona_view_tree" model="ir.ui.view">
        <field name="name">ca.titolo.persona.view.tree</field>
        <field name="model">ca.titolo_persona</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="structured"/>
            </tree>
        </field>
    </record>

    <record id="ca_titolo_persona_action" model="ir.actions.act_window">
        <field name="name">Person Title</field>
        <field name="res_model">ca.titolo_persona</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>