<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_persona_view_search" model="ir.ui.view">
        <field name="name">ca.persona.view.search</field>
        <field name="model">ca.persona</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Internal Staff" name="internal_staff"
                        domain="[('type_ids', 'ilike', 'interno')]"/>
                <filter string="External" name="external"
                        domain="[('type_ids', 'ilike', 'esterno')]"/>
                <field name="display_name"/>
                <field name="fiscalcode"/>
                <field name="type_ids"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>

    <record id="ca_persona_tree" model="ir.ui.view">
        <field name="name">ca.persona.tree</field>
        <field name="model">ca.persona</field>
        <field name="arch" type="xml">
            <list
                    decoration-danger="present == 'no'"
                    decoration-success="present == 'yes'"
                    default_order="display_name asc"
            >
                <field name="display_name"/>
                <field name="type_ids" widget="many2many_tags"/>
                <field name="parent_id"/>
                <field name="present"/>
                <field name="token" optional="hide"/>
                <field name="is_external" optional="hide"/>
                <field name="is_internal" optional="hide"/>
                <field name="is_structured" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ca_persona_form" model="ir.ui.view">
        <field name="name">ca.persona.form</field>
        <field name="model">ca.persona</field>
        <field name="arch" type="xml">
            <form>
                <t>
                    <sheet>

                        <div name="button_box" class="d-none">
                            <button
                                    name="action_draft"
                                    type="object"
                                    class="btn-secondary"
                                    string="Draft"
                                    groups="controllo_accessi.ca_ca"
                            />
                            <button
                                    name="action_documents"
                                    type="object"
                                    class="btn-secondary"
                                    string="Waiting For Documents"
                                    groups="controllo_accessi.ca_ca"
                            />
                            <button
                                    name="action_expired"
                                    type="object"
                                    class="btn-secondary"
                                    string="Expired"
                                    groups="controllo_accessi.ca_ca"
                            />
                            <button
                                    name="action_in_update"
                                    type="object"
                                    class="btn-secondary"
                                    string="In Update"
                                    groups="controllo_accessi.ca_ca"
                            />
                            <button
                                    name="action_checks_in_progress"
                                    type="object"
                                    class="btn-secondary"
                                    string="Checks In Progress"
                                    groups="controllo_accessi.ca_ca"
                            />
                            <button
                                    name="action_completed"
                                    type="object"
                                    string="Complete"
                                    class="btn-primary"
                                    groups="controllo_accessi.ca_ca"
                            />
                            <button
                                    name="action_attendance_today"
                                    type="object"
                                    string="Attendance Today"
                                    class="btn-primary"
                                    groups="controllo_accessi.ca_ca"
                            />
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <field name="ca_stato_anag_id" widget="statusbar"/>
                            <button type="object" name="btn_presence"
                                    class="oe_stat_button d-flex justify-content-end o_state_container"
                                    icon="fa-user-circle-o"
                                    t-att-class="{
                                        'btn-secondary': present == 'yes',
                                        'btn-primary active': present == 'no',
                                    }">
                                <div class="o_field_widget o_stat_info oe_right">
                                    <span class="o_stat_text">Present:</span>
                                    <span class="o_stat_value">
                                        <field name="present"/>
                                    </span>

                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="is_external" invisible="1"
                                       force_save="1"/>
                                <field name="is_internal" invisible="1"
                                       force_save="1"/>
                                <field name="is_structured" invisible="1"
                                       force_save="1"/>
                                <field name="send_to_payroll_system"/>
                                <field name="name"/>
                                <field name="lastname"/>
                                <field name="fiscalcode" required="True"/>
                                <field name="freshman"/>
                                <field name="type_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       required="True"/>
                                <field name="parent_id" />
                                <field name="associated_user_id"
                                       options="{'no_create': True}"/>
                                <field name="vat"/>
                                <field name="ca_ente_azienda_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="nationality"/>
                                <field name="birth_date"/>
                                <field name="birth_place"/>
                                <field name="istat_code"/>
                                <field name="uid"/>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="mobile"/>
                                <field name="private_mobile"
                                       groups="controllo_accessi.ca_gdpr"/>
                                <field name="token" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="address" string="Address"
                                  groups="controllo_accessi.ca_gdpr">
                                <group>
                                    <group>
                                        <span class="o_form_label o_td_label"
                                              name="address_name"
                                              groups="controllo_accessi.ca_gdpr">
                                            <b>Domicile Address</b>
                                        </span>
                                        <div class="o_address_format"
                                             groups="controllo_accessi.ca_gdpr">
                                            <field name="domicile_street"
                                                   placeholder="Street..."
                                                   class="o_address_street"/>
                                            <field name="domicile_street2"
                                                   placeholder="Street 2..."
                                                   class="o_address_street"/>
                                            <field
                                                    name="domicile_zip_id"
                                                    options="{'create_name_field': 'domicile_city', 'no_open': True, 'no_create': True}"
                                                    placeholder="City completion"
                                            />
                                            <field name="domicile_city"
                                                   placeholder="City"
                                                   class="o_address_city"/>
                                            <field name="domicile_state_id"
                                                   class="o_address_state"
                                                   placeholder="State"/>
                                            <field name="domicile_zip"
                                                   placeholder="ZIP"
                                                   class="o_address_zip"/>
                                            <div name="partner_address_country"
                                                 class="d-flex justify-content-between">
                                                <field name="domicile_country_id"
                                                       placeholder="Country"
                                                       class="o_address_country"/>
                                            </div>
                                        </div>
                                        <field name="domicile_other_than_residence"/>
                                    </group>
                                    <group>
                                        <span class="o_form_label o_td_label"
                                              name="address_name"
                                              invisible="not domicile_other_than_residence">
                                            <b>Residence Address</b>
                                        </span>
                                        <div class="o_address_format"
                                             groups="controllo_accessi.ca_gdpr">
                                            <field name="residence_street"
                                                   placeholder="Street..."
                                                   class="o_address_street"
                                                   required="domicile_other_than_residence"
                                                   invisible="not domicile_other_than_residence"/>
                                            <field name="residence_street2"
                                                   placeholder="Street 2..."
                                                   class="o_address_street"
                                                   invisible="not domicile_other_than_residence"/>
                                            <field
                                                    name="residence_zip_id"
                                                    options="{'create_name_field': 'residence_city', 'no_open': True, 'no_create': True}"
                                                    placeholder="City completion"
                                                    invisible="not domicile_other_than_residence"
                                            />
                                            <field name="residence_city"
                                                   placeholder="City"
                                                   class="o_address_city"
                                                   required="domicile_other_than_residence"
                                                   invisible="not domicile_other_than_residence"/>
                                            <field name="residence_state_id"
                                                   class="o_address_state"
                                                   placeholder="State"
                                                   required="domicile_other_than_residence"
                                                   invisible="not domicile_other_than_residence"/>
                                            <field name="residence_zip"
                                                   placeholder="ZIP"
                                                   class="o_address_zip"
                                                   required="domicile_other_than_residence"
                                                   invisible="not domicile_other_than_residence"/>
                                            <div name="partner_address_country"
                                                 class="d-flex justify-content-between">
                                                <field name="residence_country_id"
                                                       placeholder="Country"
                                                       class="o_address_country"
                                                       required="domicile_other_than_residence"
                                                       invisible="not domicile_other_than_residence"/>
                                            </div>
                                        </div>
                                    </group>
                                </group>
                            </page>
                            <page name="work_info" string="List of Work Info">
                                <field name="ca_workinfo_ids"
                                       context="{'default_ca_persona_id': active_id, 'no_create': True}">
                                    <form edit="0">
                                        <field name="state" readonly="1"
                                               widget="statusbar"/>
                                        <group>
                                            <group>
                                                <field name="ca_persona_id"/>
                                                <field name="ca_work_info_type_id"/>
                                                <field name="date_start"/>
                                            </group>
                                            <group>
                                                <field name="work_id_number"
                                                       required="1"/>
                                                <field name="ca_title_id"/>
                                                <field name="date_end"/>
                                                <field name="ca_div_uo_code"/>

                                            </group>
                                        </group>
                                    </form>
                                    <list default_order="date_end desc">
                                        <field name="ca_persona_id"
                                               column_invisible="1"/>
                                        <field name="work_id_number"/>
                                        <field name="ca_work_info_type_id"/>
                                        <field name="ca_title_id"/>
                                        <field name="ca_div_uo_code"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page name="person_tags" string="List Tags">
                                <field name="ca_tag_ids"
                                       options="{'no_create': True}"/>
                            </page>
                            <page name="identity_documents"
                                  string="List of Identity Documents"
                                  invisible="not is_external"
                                  groups="controllo_accessi.ca_gdpr">
                                <field name="ca_documento_ids">
                                    <form>
                                        <group>
                                            <field name="tipo_documento_id"/>
                                            <field name="validity_start_date"/>
                                            <field name="validity_end_date"/>
                                            <field name="issued_by"/>
                                            <field name="document_code"/>
                                            <field name="tipo_documento_name"
                                                   invisible="1"/>
                                            <field
                                                    name="image_ids"
                                                    context="{'default_ca_tipo_documento_id': tipo_documento_id,'default_name': tipo_documento_name,'default_description': tipo_documento_name}"
                                            >
                                                <list editable="bottom">
                                                    <field name="name"/>
                                                    <field name="description"/>
                                                    <field name="ca_tipo_documento_id"/>
                                                    <field name="side"/>
                                                    <field name="image"
                                                           widget="binary"
                                                           filename="filename"/>
                                                    <field name="filename"
                                                           column_invisible="1"/>
                                                </list>
                                            </field>
                                            <field name="ca_stato_documento_id"
                                                   force_save="1"/>
                                        </group>
                                    </form>
                                    <list>
                                        <field name="tipo_documento_id"/>
                                        <field name="validity_start_date"/>
                                        <field name="validity_end_date"/>
                                        <field name="image_ids"
                                               widget="many2many_tags"/>
                                        <field name="issued_by"/>
                                        <field name="document_code"/>
                                        <field name="ca_stato_documento_id"
                                               force_save="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </t>
            </form>
        </field>
    </record>

    <record id="ca_persona_action" model="ir.actions.act_window">
        <field name="name">People</field>
        <field name="res_model">ca.persona</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>