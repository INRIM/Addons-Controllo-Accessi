<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_ente_azienda__view_search" model="ir.ui.view">
        <field name="name">ca.ente.azienda.view.search</field>
        <field name="model">ca.ente_azienda</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vat"/>
                <field name="tipo_ente_azienda_id"/>
            </search>
        </field>
    </record>

    <record id="ca_ente_azienda_view_tree" model="ir.ui.view">
        <field name="name">ca.ente.azienda.view.tree</field>
        <field name="model">ca.ente_azienda</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="vat"/>
                <field name="tipo_ente_azienda_id"/>
                <field name="parent_id"/>
                <field name="child_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="ca_ente_azienda_form" model="ir.ui.view">
        <field name="name">ca.ente.azienda.form</field>
        <field name="model">ca.ente_azienda</field>
        <field name="arch" type="xml">
            <form edit="lock">
                <sheet>
                    <field name="lock" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. My Company"/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="general_info"
                              string="General Information">
                            <group>
                                <group>
                                    <field name="parent_id"
                                           options="{'no_create': True}"
                                           domain="[('id', '!=', id)]"/>
                                    <field name="all_child_ids"
                                           options="{'no_create': True}"
                                           invisible="1"/>
                                    <field name="parent_path"
                                           invisible="1"/>
                                    <span class="o_form_label o_td_label"
                                          name="address_name">
                                        <b>Address</b>
                                    </span>
                                    <div class="o_address_format">
                                        <field name="street"
                                               placeholder="Street..."
                                               class="o_address_street"/>
                                        <field name="street2"
                                               placeholder="Street 2..."
                                               class="o_address_street"/>
                                        <field
                                                name="zip_id"
                                                options="{'create_name_field': 'city', 'no_open': True, 'no_create': True}"
                                                placeholder="City completion"
                                        />
                                        <field name="city"
                                               placeholder="City"
                                               class="o_address_city"/>
                                        <field name="state_id"
                                               class="o_address_state"
                                               placeholder="State"/>
                                        <field name="zip" placeholder="ZIP"
                                               class="o_address_zip"/>
                                        <div name="partner_address_country"
                                             class="d-flex justify-content-between">
                                            <field name="country_id"
                                                   placeholder="Country"
                                                   class="o_address_country"/>
                                        </div>
                                    </div>
                                    <field name="vat"/>
                                    <field name="tz"/>
                                    <field name="note"/>
                                </group>
                                <group>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="website"/>
                                    <field name="pec"/>
                                    <field name="company_id"
                                           options="{'no_create': True}"/>
                                    <field name="tipo_ente_azienda_id"
                                           options="{'no_create': True}"/>
                                    <field name="ca_persona_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"
                                           invisible="1"
                                    />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ca_ente_azienda_action" model="ir.actions.act_window">
        <field name="name">Institution/Company</field>
        <field name="res_model">ca.ente_azienda</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>