<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_work_info_type_view_form" model="ir.ui.view">
        <field name="name">ca.work.info.type.view.form</field>
        <field name="model">ca.work_info_type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="structured"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ca_work_info_type_view_tree" model="ir.ui.view">
        <field name="name">ca.work.info.type.view.tree</field>
        <field name="model">ca.work_info_type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="structured"/>
            </tree>
        </field>
    </record>

    <record id="ca_work_info_type_action" model="ir.actions.act_window">
        <field name="name">Work Info Type</field>
        <field name="res_model">ca.work_info_type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>