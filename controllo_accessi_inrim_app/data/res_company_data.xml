<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="base.lang_it" model="res.lang">
            <field name="active" eval="True"/>
        </record>

        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'base'), ('name', '=', 'paperformat_euro')]"/>

            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <record model="report.paperformat" id="base.paperformat_euro">
            <field name="margin_bottom" eval="22"/>
        </record>

        <record id="base.main_company" model="res.company">
            <field name="name">Istituto Nazionale di Ricerca Metrologica
            </field>
            <field name="street">Strada delle Cacce, 91</field>
            <field name="city">Torino</field>
            <field name="state_id" ref="base.state_it_to"/>
            <field name="zip">10135</field>
            <field name="country_id" ref="base.it"/>
            <field name="vat">09261710017</field>
            <field name="email">inrim@pec.it</field>
            <field name="phone">+39 011 3919 1</field>
            <field name="website">https://www.inrim.it/it</field>
            <field name="currency_id" ref="base.EUR"/>
            <field name="state_id" ref="base.state_it_to"/>
            <field name="logo" type="base64"
                   file="controllo_accessi_inrim_app/static/src/img/logo.png"/>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>
    </data>
</odoo>
