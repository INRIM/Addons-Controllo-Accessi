<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_abilita_persona_locale_form" model="ir.ui.view">
        <field name="name">ca.abilita.persona.locale.view.form</field>
        <field name="model">ca.abilita_persona_locale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <field name="punto_accesso_id"/>
                    <group>
                        <group>
                            <separator string="Search in the system"/>
                            <field name="persona_id"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   required="1"
                            />
                            <field name="ca_tag_persona_id" required="1"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="allowed_date_start" readonly="1"/>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="allowed_date_end" readonly="1"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                            name="action_confirm"
                            string="Next"
                            class="btn-primary"
                            type="object"
                    />
                    <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="ca_abilita_persona_locale_action"
            model="ir.actions.act_window">
        <field name="name">Enable Local Person</field>
        <field name="res_model">ca.abilita_persona_locale</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>