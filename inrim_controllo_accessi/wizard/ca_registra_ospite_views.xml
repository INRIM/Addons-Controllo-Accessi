<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_registra_ospite_form" model="ir.ui.view">
        <field name="name">ca.registra.ospite.view.form</field>
        <field name="model">ca.registra_ospite</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="persona_id" invisible="0"/>
                    <field name="ente_azienda" invisible="0"/>
                    <field name="ente_interno" invisible="0"/>
                    <group>

                        <group>
                            <separator string="Nominativo"/>
                            <field name="fiscalcode" class=""/>
                            <field name="lastname" string="Cognome"/>
                            <field name="name" string="Nome"/>
                            <field name="freshman"/>
                            <field name="email"/>
                            <field name="mobile"/>
                        </group>
                        <group>
                            <separator string="Azienda"/>
                            <field name="vat"
                                   required="not ente_interno"
                                   invisible="ente_interno"
                            />
                            <field name="ca_ente_name"/>
                            <field name="tipo_ente_azienda_id"/>
                        </group>
                    </group>
                    <separator string="Referente"/>
                    <group>
                        <field name="parent_id"
                               required="not persona_id or persona_id.is_external == True"/>
                    </group>
                    <separator string="Dati Accesso"/>

                    <group>
                        <group>
                            <field name="ca_work_info_type_id"/>
                            <field name="date_start"/>
                            <field name="ca_tag_id"
                                   options="{'no_create': True}"
                                   domain="[('id', 'in', available_tags_ids)]"/>
                        </group>
                        <group>
                            <field name="ca_title_id"/>
                            <field name="date_end"/>
                            <field name="work_id_number"/>
                            <field name="available_tags_ids" invisible="1"/>

                        </group>
                    </group>

                </sheet>
                <footer>
                    <button
                            name="action_confirm"
                            string="Avanti"
                            class="btn-primary"
                            type="object"
                    />
                    <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="ca_registra_ospite_action" model="ir.actions.act_window">
        <field name="name">Registra Ospite</field>
        <field name="res_model">ca.registra_ospite</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>