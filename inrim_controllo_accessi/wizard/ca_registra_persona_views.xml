<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_registra_persona_form" model="ir.ui.view">
        <field name="name">ca.registra.ospite.view.form</field>
        <field name="model">ca.registra_persona</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <field name="ente_azienda" invisible="1"/>
                    <field name="ente_interno" invisible="1"/>
                    <group>
                        <group>
                            <separator string="Search in the system"/>
                            <field name="persona_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <separator string="New Name"/>
                            <field name="lastname" string="Lastname"/>
                            <field name="name" string="Name"/>
                            <field name="fiscalcode" class=""
                                   string="Fiscalcode"/>
                            <field name="freshman" string="Freshman"/>
                            <field name="email"/>
                            <field name="mobile"/>
                        </group>
                        <group>
                            <separator string="Company"/>
                            <field name="vat"
                                   required="not ente_interno"
                                   invisible="ente_interno"
                                   string="VAT"
                            />
                            <field name="ca_ente_name"/>
                            <field name="tipo_ente_azienda_id"/>
                        </group>
                    </group>
                    <separator string="Referente interno"/>
                    <group>
                        <field name="parent_id"
                               options="{'no_create': True, 'no_quick_create': True, 'no_edit':True}"
                               required="not persona_id or persona_id.is_external == True"/>
                    </group>
                    <separator string="Access Data"/>

                    <group>
                        <group>
                            <field name="ca_work_info_type_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="date_start"/>
                            <field name="ca_tag_id" string="Badge"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   domain="[('id', 'in', available_tags_ids)]"/>
                        </group>
                        <group>
                            <field name="ca_title_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="date_end"/>
                            <field name="work_id_number" invisible="1"/>
                            <field name="available_tags_ids" invisible="1"/>

                        </group>
                    </group>

                </sheet>
                <footer>
                    <button
                            name="action_confirm"
                            string="Next"
                            class="btn-primary"
                            type="object"
                    />
                    <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="ca_registra_persona_action" model="ir.actions.act_window">
        <field name="name">Register Guest</field>
        <field name="res_model">ca.registra_persona</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>