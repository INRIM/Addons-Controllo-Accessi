<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_importa_badge_generico_form" model="ir.ui.view">
        <field name="name">ca.importa.badge.generico.view.form</field>
        <field name="model">ca.importa_badge_generico</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="state" invisible="1"/>
                    <group>
                        <group>
                            <field name="tipo_badge_id"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   readonly="state == 'done'"/>
                            <field name="quantity" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="file_format" widget="radio"
                                   readonly="state == 'done'"/>
                        </group>
                    </group>

                    <group invisible="state != 'template'">
                        <separator string="Fill the Code Column"/>
                        <field name="template_file" filename="template_filename"
                               readonly="1"/>
                        <field name="template_filename" invisible="1"/>
                        <div colspan="2" class="text-muted">
                            Download the file, write the code of every badge in
                            the Codice column, then load it back here.
                        </div>
                    </group>

                    <group invisible="state == 'done'">
                        <separator string="Load the Filled File"/>
                        <field name="import_file" filename="import_filename"/>
                        <field name="import_filename" invisible="1"/>
                    </group>

                    <group invisible="state != 'done'">
                        <separator string="Result"/>
                        <field name="result_message" readonly="1" nolabel="1"
                               colspan="2"/>
                        <field name="created_tag_ids" readonly="1" nolabel="1"
                               colspan="2">
                            <list>
                                <field name="name"/>
                                <field name="tag_code"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button
                            name="action_generate_template"
                            string="Generate File"
                            class="btn-primary"
                            type="object"
                            invisible="state == 'done'"
                    />
                    <button
                            name="action_import"
                            string="Import Badges"
                            class="btn-primary"
                            type="object"
                            invisible="state == 'done' or not import_file"
                    />
                    <button
                            string="Close"
                            class="btn-secondary"
                            special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="ca_importa_badge_generico_action"
            model="ir.actions.act_window">
        <field name="name">Import Generic Badges</field>
        <field name="res_model">ca.importa_badge_generico</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
