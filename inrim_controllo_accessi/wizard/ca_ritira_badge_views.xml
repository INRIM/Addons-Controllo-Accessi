<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_restituisci_badge_form" model="ir.ui.view">
        <field name="name">ca.restituisci.badge.view.form</field>
        <field name="model">ca.restituisci_badge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <separator string="Dati Badge"/>

                    <group>
                        <group>
                            <field name="ca_tag_id"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   domain="[('id', 'in', available_tags_ids)]"/>
                        </group>
                        <group>
                            <field name="available_tags_ids" invisible="1"/>

                        </group>
                    </group>

                </sheet>
                <footer>
                    <button
                            name="action_confirm"
                            string="Avanti"
                            class="btn-primary"
                            type="object"
                    />
                    <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="ca_restituisci_badge_action" model="ir.actions.act_window">
        <field name="name">Registra Ospite</field>
        <field name="res_model">ca.restituisci_badge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>