<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Proprieta tag mancanti in inrim_anagrafiche -->
        <record id="proprieta_tag_visiting" model="ca.proprieta_tag">
            <field name="name">Visiting</field>
        </record>

        <record id="proprieta_tag_support_staff" model="ca.proprieta_tag">
            <field name="name">Support Staff</field>
        </record>

        <record id="proprieta_tag_visiting_accredia" model="ca.proprieta_tag">
            <field name="name">Visiting Accredia</field>
        </record>

        <record id="proprieta_tag_external_contractor" model="ca.proprieta_tag">
            <field name="name">External Contractor</field>
        </record>

        <!-- Tipi badge generico -->
        <record id="tipo_badge_generico_jolly" model="ca.tipo_badge_generico">
            <field name="name">Jolly</field>
            <field name="badge_prefix">Badge Jolly</field>
            <field name="sequence">5</field>
            <field name="ca_proprieta_tag_id"
                   ref="inrim_anagrafiche.proprieta_tag_jolly"/>
            <field name="ca_proprieta_tag_default_ids" eval="[(6, 0, [
                ref('inrim_anagrafiche.proprieta_tag_valido'),
                ref('inrim_anagrafiche.proprieta_tag_temporaneo')
            ])]"/>
            <field name="person_type">internal</field>
            <field name="description">Badge sostitutivo per il personale interno</field>
        </record>

        <record id="tipo_badge_generico_visiting" model="ca.tipo_badge_generico">
            <field name="name">Visiting</field>
            <field name="sequence">10</field>
            <field name="ca_proprieta_tag_id" ref="proprieta_tag_visiting"/>
            <field name="ca_proprieta_tag_default_ids" eval="[(6, 0, [
                ref('inrim_anagrafiche.proprieta_tag_valido'),
                ref('inrim_anagrafiche.proprieta_tag_temporaneo')
            ])]"/>
            <field name="person_type">external</field>
        </record>

        <record id="tipo_badge_generico_visitatore" model="ca.tipo_badge_generico">
            <field name="name">Visitatore</field>
            <field name="sequence">20</field>
            <field name="ca_proprieta_tag_id"
                   ref="inrim_anagrafiche.proprieta_tag_visitatore"/>
            <field name="ca_proprieta_tag_default_ids" eval="[(6, 0, [
                ref('inrim_anagrafiche.proprieta_tag_valido'),
                ref('inrim_anagrafiche.proprieta_tag_temporaneo')
            ])]"/>
            <field name="person_type">external</field>
        </record>

        <record id="tipo_badge_generico_support_staff" model="ca.tipo_badge_generico">
            <field name="name">Support Staff</field>
            <field name="sequence">30</field>
            <field name="ca_proprieta_tag_id" ref="proprieta_tag_support_staff"/>
            <field name="ca_proprieta_tag_default_ids" eval="[(6, 0, [
                ref('inrim_anagrafiche.proprieta_tag_valido'),
                ref('inrim_anagrafiche.proprieta_tag_temporaneo')
            ])]"/>
            <field name="person_type">external</field>
            <field name="same_day_default" eval="False"/>
        </record>

        <record id="tipo_badge_generico_visiting_accredia"
                model="ca.tipo_badge_generico">
            <field name="name">Visiting Accredia</field>
            <field name="sequence">40</field>
            <field name="ca_proprieta_tag_id" ref="proprieta_tag_visiting_accredia"/>
            <field name="ca_proprieta_tag_default_ids" eval="[(6, 0, [
                ref('inrim_anagrafiche.proprieta_tag_valido'),
                ref('inrim_anagrafiche.proprieta_tag_temporaneo')
            ])]"/>
            <field name="person_type">external</field>
            <field name="same_day_default" eval="False"/>
        </record>

        <record id="tipo_badge_generico_external_contractor"
                model="ca.tipo_badge_generico">
            <field name="name">External Contractor</field>
            <field name="sequence">50</field>
            <field name="ca_proprieta_tag_id" ref="proprieta_tag_external_contractor"/>
            <field name="ca_proprieta_tag_default_ids" eval="[(6, 0, [
                ref('inrim_anagrafiche.proprieta_tag_valido'),
                ref('inrim_anagrafiche.proprieta_tag_temporaneo')
            ])]"/>
            <field name="person_type">external</field>
            <field name="same_day_default" eval="False"/>
        </record>
    </data>
</odoo>
