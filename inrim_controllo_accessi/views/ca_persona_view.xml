<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_persona_view_ca_form_inherit" model="ir.ui.view">
        <field name="name">ca.persona.view.ca.form.inherit</field>
        <field name="model">ca.persona</field>
        <field name="inherit_id" ref="inrim_anagrafiche.ca_persona_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='person_tags']" position="after">
                <field name="ref" readonly="True"/>
                <field name="lock" readonly="True"/>
                <page name="person_access" string="List Access">
                    <field name="person_access_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>


</odoo>