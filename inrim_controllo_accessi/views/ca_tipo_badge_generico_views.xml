<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_tipo_badge_generico_view_search" model="ir.ui.view">
        <field name="name">ca.tipo_badge_generico.view.search</field>
        <field name="model">ca.tipo_badge_generico</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="badge_prefix"/>
                <field name="ca_proprieta_tag_id"/>
                <field name="person_type"/>
            </search>
        </field>
    </record>

    <record id="ca_tipo_badge_generico_view_tree" model="ir.ui.view">
        <field name="name">ca.tipo_badge_generico.view.tree</field>
        <field name="model">ca.tipo_badge_generico</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="ca_proprieta_tag_id"
                       options="{'no_create': True, 'no_quick_create': True}"/>
                <field name="ca_proprieta_tag_default_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"/>
                <field name="person_type"/>
                <field name="same_day_default"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="ca_tipo_badge_generico_view_form" model="ir.ui.view">
        <field name="name">ca.tipo_badge_generico.view.form</field>
        <field name="model">ca.tipo_badge_generico</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="badge_prefix"
                                   placeholder="Same as the type name"/>
                            <field name="ca_proprieta_tag_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="person_type"/>
                            <field name="same_day_default"/>
                        </group>
                        <group>
                            <field name="ca_proprieta_tag_default_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ca_tipo_badge_generico_action" model="ir.actions.act_window">
        <field name="name">Generic Badge Type</field>
        <field name="res_model">ca.tipo_badge_generico</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
