<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_punto_accesso_view_search" model="ir.ui.view">
        <field name="name">ca.punto.accesso.view.search</field>
        <field name="model">ca.punto_accesso</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ente_azienda_id"/>
                <field name="ca_lettore_id"/>
                <field name="direction"/>
                <field name="typology"/>
                <field name="ca_persona_id"/>
                <field name="last_update_reader"/>
                <field name="last_reading_events"/>
                <field name="events_to_read_num"/>
                <field name="events_read_num"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <filter string="Enabled" name="enabled"
                        domain="[('enable_sync', '=', True)]"/>
                <filter string="Disabled" name="disabled"
                        domain="[('enable_sync', '=', False)]"/>
                <filter string="In Error" name="in_error"
                        domain="[('system_error', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="ca_punto_accesso_view_tree" model="ir.ui.view">
        <field name="name">ca.punto.accesso.view.tree</field>
        <field name="model">ca.punto_accesso</field>
        <field name="arch" type="xml">
            <tree default_order="ente_azienda_id asc">
                <field name="name"/>
                <field name="ente_azienda_id"/>
                <field name="ca_lettore_id"/>
                <field name="system_error"/>
                <field name="direction"/>
                <field name="typology"/>
                <field name="ca_persona_id"/>
                <field name="last_update_reader"/>
                <field name="last_reading_events"/>
                <field name="events_to_read_num"/>
                <field name="events_read_num"/>
                <field name="enable_sync"/>
                <field name="recursive_read_events"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </tree>
        </field>
    </record>

    <record id="ca_punto_accesso_view_form" model="ir.ui.view">
        <field name="name">ca.punto.accesso.view.form</field>
        <field name="model">ca.punto_accesso</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box">
                        <button
                                name="%(inrim_controllo_accessi.ca_sposta_punto_accesso_action)d"
                                string="Move Access Point"
                                type="action"
                                context="{'default_old_ca_spazio_id': ca_spazio_id, 'default_ca_punto_accesso_id': id}"
                        />
                        <button
                                name="commuta_abilitazione"
                                string="Enable"
                                type="object"
                                icon="fa-play-circle-o"
                                invisible="enable_sync"
                                confirm="Are you sure you want to enable this record?"
                                groups="controllo_accessi.ca_tech"
                        />
                        <button
                                name="commuta_abilitazione"
                                string="Disable"
                                type="object"
                                icon="fa-stop-circle-o"
                                invisible="not enable_sync"
                                confirm="Are you sure you want to disable this record?"
                                groups="controllo_accessi.ca_tech"
                        />
                        <button
                                name="action_abilita_persona_locale"
                                type="object"
                                icon="fa-id-badge"
                                string="Add person in local"
                                groups="controllo_accessi.ca_ca"
                                invisible="typology=='stamping'"
                        />
                        <button
                                name="accessi_oggi"
                                string="Accessed Today"
                                type="object"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="True"/>
                            <field name="ca_spazio_id"
                                   options="{'no_create': True}"
                                   readonly="enable_sync"/>
                            <field name="ca_lettore_id"
                                   options="{'no_create': True}"
                                   readonly="enable_sync"/>
                            <field name="typology" readonly="enable_sync"/>
                            <field name="ca_category"
                                   required="typology == 'stamping'"/>
                        </group>
                        <group>
                            <field name="events_to_read_num"/>
                            <field name="recursive_read_events"/>
                            <field name="date_start" readonly="enable_sync"/>
                            <field name="date_end" readonly="enable_sync"/>
                        </group>
                    </group>
                    <separator string="Reader Info"/>
                    <group>
                        <group>
                            <field name="tipo_spazio_id" readonly="1"/>
                            <field name="ente_azienda_id" readonly="1"/>
                            <field name="direction"/>
                            <field name="tz"/>
                            <field name="type_ids" invisible="True"/>
                        </group>
                        <group>
                            <field name="system_error"/>
                            <field name="last_update_reader" readonly="True"/>
                            <field name="last_reading_events" readonly="True"/>
                            <field name="available_events" readonly="True"/>
                            <field name="enable_sync" readonly="True"/>
                            <field name="remote_update" readonly="True"/>
                        </group>
                        <field name="ca_persona_id" readonly="True"
                               domain="[('type_ids', 'in', type_ids)]"/>
                        <notebook>
                            <page name="people" string="People">
                                <field name="ca_tag_lettore_persona_view" >
                                    <tree default_order="ca_persona_id asc, date_end asc" options="{'no_create': True}">
                                        <field name="ca_lettore_id" column_invisible="1"/>
                                        <field name="ca_persona_id"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="tags" string="Tags">
                                <field name="ca_tag_lettore_ids"
                                       context="{'default_ca_lettore_id': ca_lettore_id}"
                                       readonly="not ca_lettore_id">
                                    <form>
                                        <group>
                                            <group>
                                                <field name="state" widget="statusbar"/>
                                                <field name="name"
                                                       readonly="True"/>
                                                <field name="ca_lettore_id"
                                                       options="{'no_create': True}"
                                                       readonly="1"/>
                                                <field name="ca_tag_id"
                                                       options="{'no_create': True}"/>
                                                <field name="date_start"
                                                       readonly="False"/>
                                                <field name="date_end"
                                                       readonly="False"/>
                                                <field name="tag_in_use"/>
                                            </group>
                                            <group>
                                                <field name="date_start"
                                                       readonly="False"/>
                                                <field name="date_end"
                                                       readonly="False"/>
                                                <field name="temp"/>

                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ca_punto_accesso_view_kanban" model="ir.ui.view">
        <field name="name">ca.punto.accesso.view.kanban</field>
        <field name="model">ca.punto_accesso</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong>
                                <field name="name"/>
                                <br/>
                            </strong>
                            <span name="ca_spazio_id">
                                Position:
                                <field name="ca_spazio_id"/>
                                <br/>
                            </span>
                            <span name="ente_azienda_id">
                                Headquarters Location:
                                <field name="ente_azienda_id"/>
                                <br/>
                            </span>
                            <span name="ca_lettore_id">
                                Reader:
                                <field name="ca_lettore_id"/>
                                <br/>
                            </span>
                            <span name="system_error">
                                Reader Error:
                                <field name="system_error"/>
                                <br/>
                            </span>
                            <span name="events_to_read_num">
                                Number of Events To Read:
                                <field name="events_to_read_num"/>
                                <br/>
                            </span>
                            <span name="events_read_num">
                                Number of Events Read:
                                <field name="events_read_num"/>
                                <br/>
                            </span>
                            <span name="enable_sync">
                                Enabled:
                                <field name="enable_sync"/>
                                <br/>
                            </span>
                            <span name="date_start">
                                Date Start:
                                <field name="date_start"/>
                                <br/>
                            </span>
                            <span name="date_end">
                                Date End:
                                <field name="date_end"/>
                                <br/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ca_punto_accesso_action" model="ir.actions.act_window">
        <field name="name">Access Point</field>
        <field name="res_model">ca.punto_accesso</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>