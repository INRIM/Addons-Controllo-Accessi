<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ca_punto_accesso_category_view_form" model="ir.ui.view">
        <field name="name">ca_punto_accesso_category.view.form</field>
        <field name="model">ca.punto_accesso_category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box">
                        <button
                                name="action_add_person"
                                type="object"
                                icon="oi-smile-add"
                                string="Add Badge Person"
                                groups="controllo_accessi.ca_ca"
                        />
                        <button
                                name="action_restituisci_badge"
                                type="object"
                                icon="fa fa-id-badge"
                                string="Give Back Badge"
                                groups="controllo_accessi.ca_ca"
                        />
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="description"/>
                    <notebook>
                        <page name="Access Points" string="Access Points">
                            <field name="ca_access_point_ids" readonly="True">
                                <tree>
                                    <field name="name"/>
                                    <field name="typology"/>
                                    <field name="direction"/>
                                    <field name="enable_sync"/>
                                    <field name="system_error"/>
                                </tree>
                            </field>
                        </page>
                        <page name="tag_persona" string="Tag Person">
                            <field name="ca_tag_persona_ids">
                                <tree default_order="date_start desc, date_end desc">
                                    <field name="ca_persona_id"/>
                                    <field name="ca_tag_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="temp"/>
                                    <field name="state"/>
                                </tree>
                                <form>
                                    <field name="ca_persona_id"/>
                                    <field name="ca_tag_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="temp"/>
                                    <field name="state"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ca_punto_accesso_category_view_tree" model="ir.ui.view">
        <field name="name">ca_punto_accesso_category.view.tree</field>
        <field name="model">ca.punto_accesso_category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="ca_punto_accesso_category_action"
            model="ir.actions.act_window">
        <field name="name">Access Point Category</field>
        <field name="res_model">ca.punto_accesso_category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>