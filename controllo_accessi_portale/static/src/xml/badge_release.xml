<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="controllo_accessi_portale.BadgeRelease" owl="1">
        <div class="container-fluid mt-2 mb-4" style="max-width: 1200px;">

            <div class="d-flex justify-content-between align-items-center mb-4 bg-light p-3 rounded shadow-sm">
                <div class="d-flex align-items-center">
                    <img src="/logo.png" alt="Logo" style="height: 40px;" class="me-3"/>
                    <h3 class="mb-0 text-primary">
                        <t t-esc="texts.issueBadge"/>
                    </h3>
                </div>
                <a href="/anagrafiche" class="btn btn-outline-secondary shadow-sm">
                    <i class="fa fa-arrow-left me-1"/>
                    <span>
                        <t t-esc="texts.partnerList"/>
                    </span>
                </a>
            </div>

            <div t-if="props.error_message or state.errorMessage" class="alert alert-danger d-flex align-items-center shadow-sm" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <div t-esc="props.error_message or state.errorMessage"/>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="POST" action="/badge_release/submit" class="form-group needs-validation" novalidate="true">
                        <input type="hidden" name="csrf_token" t-att-value="state.csrfToken"/>

                        <div class="mb-4 bg-light p-3 rounded border">
                            <h5 class="text-primary mb-3">
                                <i class="fa fa-search me-2"/>
                                <span>
                                    <t t-esc="texts.findInSystem"/>
                                </span>
                            </h5>
                            <div class="row align-items-center">
                                <label for="persona_id" class="col-md-2 col-form-label fw-bold">
                                    <t t-esc="texts.existingPartner"/>
                                </label>
                                <div class="col-md-10">
                                    <SelectMenu
                                        choices="personaChoices"
                                        value="state.selectedPersonaId"
                                        onSelect.bind="onPersonaSelect"
                                        placeholder="texts.selectPartner"
                                    />
                                    <input type="hidden" name="persona_id" t-att-value="state.formValues.persona_id or ''"/>
                                    <small class="text-muted">
                                        <t t-esc="texts.selectPartnerHelp"/>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <h5 class="text-secondary mb-3 border-bottom pb-2">
                            <i class="fa fa-user me-2"/>
                            <span>
                                <t t-esc="texts.personalDetails"/>
                            </span>
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="lastname" class="form-label">
                                    <t t-esc="texts.lastName"/>
                                </label>
                                <input type="text" id="lastname" name="lastname" required="True" class="form-control" t-on-change="onLastnameChange" t-att-value="state.formValues.lastname"/>
                            </div>
                            <div class="col-md-6">
                                <label for="name" class="form-label">
                                    <t t-esc="texts.firstName"/>
                                </label>
                                <input type="text" id="name" name="name" class="form-control" required="True" t-on-change="onNameChange" t-att-value="state.formValues.name"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <input type="hidden" name="azienda" t-att-value="state.formValues.ente_azienda"/>
                            <div class="col-md-6">
                                <label for="fiscalcode" class="form-label">
                                    <t t-esc="texts.fiscalCode"/>
                                </label>
                                <input type="text" id="fiscalcode" name="fiscalcode" required="True" class="form-control" t-att-value="state.formValues.fiscalcode" t-on-change="onFiscalcodeChange"/>
                            </div>
                            <div class="col-md-6" t-att-class="{'d-none': state.enteInterno}">
                                <label for="vat" class="form-label">
                                    <t t-esc="texts.vatNumber"/>
                                </label>
                                <input type="text" id="vat" name="vat" class="form-control" t-att-value="state.formValues.vat" t-on-change="onVatChange"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="ca_ente_name" class="form-label">
                                    <t t-esc="texts.companyName"/>
                                </label>
                                <input type="text" id="ca_ente_name" name="ca_ente_name" required="True" class="form-control" t-on-change="onEnteNameChange" t-att-value="state.formValues.ca_ente_name"/>
                            </div>
                            <div class="col-md-6">
                                <label for="tipo_ente_azienda_id" class="form-label">
                                    <t t-esc="texts.entityType"/>
                                    <t t-if="!state.selectedPersonaId"> *</t>
                                </label>
                                <select id="tipo_ente_azienda_id" name="tipo_ente_azienda_id" class="form-control" t-att-required="!state.selectedPersonaId" t-on-change="OnTipoEnteChange" t-att-value="state.formValues.tipo_ente_azienda_id">
                                    <option value=""/>
                                    <t t-foreach="tipo_ente_azienda" t-as="ente" t-key="ente.id">
                                        <option t-att-value="ente.id">
                                            <t t-esc="ente.display_name"/>
                                        </option>
                                    </t>
                                    <t t-foreach="tipo_ente_azienda_hidden" t-as="ente" t-key="ente.id">
                                        <option t-att-value="ente.id" style="display: none;">
                                            <t t-esc="ente.display_name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <label for="email" class="form-label">
                                    <t t-esc="texts.email"/>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-envelope"/>
                                    </span>
                                    <input type="email" id="email" name="email" class="form-control" t-att-value="state.formValues.email" t-on-change="onEmailChange"/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label for="mobile" class="form-label">
                                    <t t-esc="texts.mobile"/>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-mobile"/>
                                    </span>
                                    <input type="text" id="mobile" name="mobile" class="form-control" t-on-change="onMobileChange" t-att-value="state.formValues.mobile"/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label for="freshman" class="form-label">
                                    <t t-esc="texts.idNumber"/>
                                </label>
                                <input type="text" id="freshman" name="freshman" class="form-control" t-on-change="OnFreshmanChange" t-att-value="state.formValues.freshman"/>
                            </div>
                        </div>

                        <h5 class="text-secondary mb-3 border-bottom pb-2">
                            <i class="fa fa-building me-2"/>
                            <span>
                                <t t-esc="texts.internalContact"/>
                            </span>
                        </h5>

                        <div class="row mb-4 bg-light p-3 rounded mx-0 border">
                            <div class="col-md-6">
                                <label for="ref_domain_sel" class="form-label">
                                    <t t-esc="texts.searchDomain"/>
                                </label>
                                <input type="hidden" name="ref_domain" t-if="state.isPersonaInternal" t-att-value="state.formValues.ref_domain || 'present'"/>

                                <select id="ref_domain_sel" name="ref_domain" class="form-control" required="True" t-on-change="onRefDomainChange" t-att-disabled="state.isPersonaInternal" t-att-value="state.formValues.ref_domain">
                                    <option value="present">
                                        <t t-esc="texts.presentToday"/>
                                    </option>
                                    <option value="all">
                                        <t t-esc="texts.all"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="parent_id" class="form-label">
                                    <t t-esc="texts.referencePerson"/>
                                </label>
                                <input type="hidden" name="parent_id" t-att-value="state.formValues.parent_id or ''"/>
                                <div t-att-class="{'pe-none opacity-50': state.isPersonaInternal}">
                                    <SelectMenu
                                        choices="parentChoices"
                                        value="state.formValues.parent_id"
                                        onSelect.bind="onParentSelect"
                                        placeholder="texts.selectRepresentative"
                                    />
                                </div>
                                <div t-if="state.submitted and !state.isPersonaInternal and !state.formValues.parent_id" class="text-danger small mt-1">
                                    <t t-esc="texts.fieldRequired"/>
                                </div>
                            </div>
                        </div>

                        <h5 class="text-secondary mb-3 border-bottom pb-2">
                            <i class="fa fa-id-card me-2"/>
                            <span>
                                <t t-esc="texts.accessDetails"/>
                            </span>
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="ca_work_info_type_id" class="form-label">
                                    <t t-esc="texts.workType"/>
                                </label>
                                <SelectMenu
                                    choices="workInfoChoices"
                                    value="state.formValues.work_info_type"
                                    onSelect.bind="onWorkInfoSelect"
                                    placeholder="texts.selectWorkInfo"
                                />
                                <input type="hidden" name="ca_work_info_type_id" t-att-value="state.formValues.work_info_type or ''"/>
                                <div t-if="state.submitted and !state.formValues.work_info_type" class="text-danger small mt-1">
                                    <t t-esc="texts.fieldRequired"/>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="ca_title_id" class="form-label">
                                    <t t-esc="texts.titleQualification"/>
                                </label>
                                <SelectMenu
                                    choices="titleChoices"
                                    value="state.formValues.ca_title"
                                    onSelect.bind="onTitleSelect"
                                    placeholder="texts.selectTitle"
                                />
                                <input type="hidden" name="ca_title_id" t-att-value="state.formValues.ca_title or ''"/>
                                <div t-if="state.submitted and !state.formValues.ca_title" class="text-danger small mt-1">
                                    <t t-esc="texts.fieldRequired"/>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="ca_tag_id" class="col-md-2 col-form-label fw-bold">
                                <t t-esc="texts.assignBadge"/>
                            </label>
                            <div class="col-md-10">
                                <SelectMenu
                                    choices="tagChoices"
                                    value="state.formValues.ca_tag_id"
                                    onSelect.bind="onTagSelect"
                                    placeholder="texts.selectBadge"
                                />
                                <input type="hidden" name="ca_tag_id" t-att-value="state.formValues.ca_tag_id or ''"/>
                                <div t-if="state.submitted and !state.formValues.ca_tag_id" class="text-danger small mt-1">
                                    <t t-esc="texts.fieldRequired"/>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4" id="date-ctn">
                            <input type="hidden" name="date_end_iso" t-att-value="state.formValues.date_end ? state.formValues.date_end.toISO() : ''"/>
                            <input type="hidden" name="date_start_iso" t-att-value="state.formValues.date_start ? state.formValues.date_start.toISO() : ''"/>

                            <div class="col-md-6">
                                <label for="datestart" class="form-label">
                                    <t t-esc="texts.startDate"/>
                                </label>
                                <input type="datetime-local" id="datestart" name="date_start" class="form-control" t-att-value="formatDateForInput(state.formValues.date_start)" t-on-change="onDateStartChange" required="true"/>
                            </div>
                            <div class="col-md-6">
                                <label for="dateend" class="form-label">
                                    <t t-esc="texts.endDate"/>
                                </label>
                                <input type="datetime-local" id="dateend" name="date_end" class="form-control" t-att-value="formatDateForInput(state.formValues.date_end)" t-on-change="onDateEndChange" required="true"/>
                            </div>
                        </div>

                        <hr/>

                        <div class="d-flex justify-content-center mt-3">
                            <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm" t-on-click="onSubmitClick">
                                <i class="fa fa-check-circle me-2"/>
                                <span>
                                    <t t-esc="texts.issueBadge"/>
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </t>
</templates>
