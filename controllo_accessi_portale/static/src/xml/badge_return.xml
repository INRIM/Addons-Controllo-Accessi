<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="controllo_accessi_portale.BadgeReturn" owl="1">
        <div class="container-fluid mt-2 mb-4" style="max-width: 900px;">
            <div class="d-flex justify-content-between align-items-center mb-4 bg-light p-3 rounded shadow-sm">
                <div class="d-flex align-items-center">
                    <img src="/logo.png" alt="Logo" style="height: 40px;" class="me-3"/>
                    <h3 class="mb-0 text-primary">
                        <t t-esc="texts.badgeReturn"/>
                    </h3>
                </div>
                <a href="/anagrafiche" class="btn btn-outline-secondary shadow-sm">
                    <i class="fa fa-arrow-left me-1"/>
                    <span>
                        <t t-esc="texts.partnerList"/>
                    </span>
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fa fa-id-badge text-info me-2"/>
                        <span>
                            <t t-esc="texts.returnDetails"/>
                        </span>
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form method="POST" action="/badge_return/submit">
                        <div class="row mb-4 align-items-center bg-light p-3 rounded mx-0 border">
                            <label for="tag_code" class="col-md-3 col-form-label fw-bold">
                                <i class="fa fa-barcode me-1"/>
                                <span>
                                    <t t-esc="texts.tagCode"/>
                                </span>
                            </label>
                            <div class="col-md-9">
                                <input id="tag_code" name="tag_code" class="form-control form-control-lg" t-att-placeholder="texts.enterCodeHere" t-model="state.tag_code" autofocus="1" t-on-keydown="onKeyDownTagCode"/>
                                <small class="text-muted">
                                    <t t-esc="texts.pressEnter"/>
                                </small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="tag_id" class="col-md-3 col-form-label">
                                <t t-esc="texts.selectBadgeLabel"/>
                            </label>
                            <div class="col-md-6">
                                <SelectMenu
                                    choices="tagChoices"
                                    value="state.selectedTag"
                                    onSelect.bind="onTagSelect"
                                    placeholder="texts.selectBadgePlaceholder"
                                />
                                <input type="hidden" name="tag_id" t-att-value="state.selectedTag or ''"/>
                            </div>

                            <div class="col-md-3 d-flex align-items-center justify-content-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="temp" t-att-checked="state.temp" t-on-change="OnTempChange"/>
                                    <label class="form-check-label" for="temp">
                                        <t t-esc="texts.temporaryOnly"/>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <label for="persona_id" class="col-md-3 col-form-label">
                                <t t-esc="texts.associatedPartner"/>
                            </label>
                            <div class="col-md-9">
                                <input id="persona_id" name="persona_id" class="form-control bg-white" t-att-value="state.selectedPersona" readonly="true" t-att-placeholder="texts.partnerDisplayedHere"/>
                            </div>
                        </div>

                        <hr/>

                        <div class="d-flex justify-content-center mt-3">
                            <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm" t-att-disabled="!state.selectedTag">
                                <i class="fa fa-check-circle me-2"/>
                                <span>
                                    <t t-esc="texts.confirmReturn"/>
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </t>
</templates>