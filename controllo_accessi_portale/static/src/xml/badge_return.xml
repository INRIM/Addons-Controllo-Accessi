<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="controllo_accessi_portale.BadgeReturn" name="Badge Return" owl="1">
        <div class="container mt-4 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <h1>Badge Return</h1>
                <a href="/anagrafiche" class="btn btn-secondary">Back to Partner List</a>
            </div>

            <form method="POST" action="/badge_return/submit" class="form-group">
                <div style="margin-top:25px;">
                    <h6>Badge Data</h6>
                    <hr/>
                </div>

                <div class="row mb-3">
                    <div class="col-md-1">
                        <label for="tag_id" class="form-label">Tag</label>
                    </div>
                    <div class="col-md-6">
                        <select t-ref="tagSelect" id="tag_id" name="tag_id" class="form-control" style="margin-bottom: 10px;" t-att-value="state.selectedTag" required="true">
                            <option value=""/>
                            <t t-foreach="tagFiltered" t-as="tag" t-key="tag.id">
                                <option t-att-value="tag.id">
                                    <t t-esc="tag.display_name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-1">
                        <label for="persona_id" class="form-label">Partner</label>
                    </div>
                    <div class="col-md-6">
                        <input id="persona_id" name="persona_id" class="form-control" style="margin-bottom: 10px;" t-att-value="state.selectedPersona" readonly="true"/>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-1">
                        <label for="temp">Temporary</label>
                    </div>
                    <div class="col-md-6">
                        <input type="checkbox" id="temp" class="form-check-input" t-att-checked="state.temp" t-on-change="OnTempChange"/>
                    </div>
                </div>
                <div class="d-flex justify-content-center mt-4">
                    <button type="submit" class="btn btn-primary">Return Badge</button>
                </div>
            </form>
        </div>
    </t>
</templates>
